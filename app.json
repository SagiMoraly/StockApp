{
  "expo": {
    "name": "StockApp",
    "slug": "stockapp",
    "version": "1.0.0",
    "scheme": "com.stockapp.mobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EC"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockapp.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow StockApp to access your photos so you can add recipe images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stockapp.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleWebClientId": "890366013814-vkijtj7b4i0sjra8ujb19h77kv0u6klb.apps.googleusercontent.com",
      "googleAndroidClientId": "890366013814-vkijtj7b4i0sjra8ujb19h77kv0u6klb.apps.googleusercontent.com",
      "googleIosClientId": "890366013814-vkijtj7b4i0sjra8ujb19h77kv0u6klb.apps.googleusercontent.com",
      "supportEmail": "support@stockapp.app",
      "privacyPolicyUrl": "https://stockapp.app/privacy",
      "supportUrl": "https://stockapp.app/support",
      "marketingUrl": "https://stockapp.app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StockApp to access your photos so you can add recipe images."
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
